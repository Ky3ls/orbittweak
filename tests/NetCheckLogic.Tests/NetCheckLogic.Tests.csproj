<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks of the pure logic of the Netz-Check (numbers per stage, where a lag starts, advice, the copied text,
       server addresses) that run anywhere, also on Linux. How to run them: see Program.cs -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OrbitTweak.Tests</RootNamespace>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Core/NetCheckLogic.cs" Link="Core/NetCheckLogic.cs" />
  </ItemGroup>
</Project>
