    <Compile Include="../../Core/KillLogic.cs" Link="Core/KillLogic.cs" />
    <Compile Include="../../Core/TweakLogic.cs" Link="Core/TweakLogic.cs" />
    <Compile Include="../../Core/PlayStats.cs" Link="Core/PlayStats.cs" />
    <Compile Include="../../Core/GfxFile.cs" Link="Core/GfxFile.cs" />
    <Compile Include="../../Core/FpsTexLogic.cs" Link="Core/FpsTexLogic.cs" />
  </ItemGroup>
</Project>
