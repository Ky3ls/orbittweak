<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks of the pure rules of the "Andere Spiele" tweaks (Fortnite, Counter-Strike 2, Rainbow Six Siege) that run
       anywhere, also on Linux (see Program.cs for how to run them) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OrbitTweak.Tests</RootNamespace>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Core/Games/IniText.cs" Link="Core/Games/IniText.cs" />
    <Compile Include="../../Core/Games/*Logic.cs" LinkBase="Core/Games" />
  </ItemGroup>
</Project>
