<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks of the pure logic of the Tweak-Wächter (reset found by two looks in a row, skip rules, the FPS limit, what
       "Wieder anwenden" and "So lassen" act on) that run anywhere, also on Linux. How to run them: see Program.cs -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OrbitTweak.Tests</RootNamespace>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Core/TweakGuardLogic.cs" Link="Core/TweakGuardLogic.cs" />
  </ItemGroup>
</Project>
